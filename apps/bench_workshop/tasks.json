    {
      "id": "T06_no_room",
      "name": "No room for another",
      "level": "L1",
      "seed": 0,
      "max_steps": 14,
      "tags": [
        "refusal"
      ],
      "instruction": "Press the max button on the garden bench and tell me what the app says.",
      "goal": [
        {
          "name": "The plan did not move",
          "path": "derived.benches",
          "op": "eq",
          "value": 6
        },
        {
          "name": "Tables did not move either",
          "path": "derived.tables",
          "op": "eq",
          "value": 3
        },
        {
          "name": "no room for another",
          "source": "answer",
          "op": "regex",
          "value": "(no room|none|(?<!\\d)0(?!\\d)|cannot|can't|short)",
          "weight": 3
        },
        {
          "name": "and says what runs out",
          "source": "answer",
          "op": "regex",
          "value": "(?<![A-Za-z])(?:shelf|carri|carry|past|already|room)"
        }
      ],
      "answer_expected": true
    },
