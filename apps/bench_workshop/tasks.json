  "tasks": [
    {
      "id": "T01_settings",
      "name": "Two switches",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "In Setup, stop the shelf printing pack sizes and switch the app over to gross requirements instead of netting the plan off what is in stock. Leave the third switch alone.",
      "goal": [
        {
          "name": "Pack sizes are hidden",
          "path": "derived.settings.showPacks",
          "op": "eq",
          "value": false
        },
        {
          "name": "Gross requirements",
          "path": "derived.settings.netOffStock",
          "op": "eq",
          "value": false
        },
        {
          "name": "The third switch is untouched",
          "path": "derived.settings.warnShort",
          "op": "eq",
          "value": true
        },
        {
          "name": "The plan was not changed",
          "path": "derived.benches",
          "op": "eq",
          "value": 6
        }
      ]
    },
    {
      "id": "T02_fix_cost",
      "name": "Question: what does the shortfall cost?",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "The plan as it stands does not fit on the shelf. How much would it cost to order what is missing?",
      "goal": [
        {
          "name": "£39.00",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)39(?!\\d)",
          "weight": 3
        },
        {
          "name": "Nothing was ordered",
          "path": "derived.basketCost",
          "op": "eq",
          "value": 0
        }
      ],
      "answer_expected": true
    },
