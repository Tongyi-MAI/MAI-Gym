        {
          "name": "Internal is unchanged",
          "path": "derived.internalFree",
          "op": "eq",
          "value": 2403
        },
        {
          "name": "The card lost 7.91 GB",
          "path": "derived.sdFree",
          "op": "eq",
          "value": 19268
