      "name": "Copy instead of move",
      "level": "L2",
      "seed": 0,
      "max_steps": 24,
      "tags": [
        "copy",
        "reasoning"
      ],
      "instruction": "Copy the WhatsApp Video folder to the SD card instead of moving it. Then say how much internal storage that freed.",
