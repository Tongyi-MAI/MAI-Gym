  "tasks": [
    {
      "id": "T01_porch_light",
      "name": "Porch light on at 60%",
      "level": "L1",
      "seed": 0,
      "max_steps": 14,
      "tags": [
        "light",
        "slider"
      ],
      "instruction": "Turn the Porch Light on and set its brightness to 60%.",
      "goal": [
        {
          "name": "Porch light is on",
          "path": "devices.d_porch.on",
          "op": "eq",
          "value": true
        },
        {
          "name": "Brightness is 60%",
          "path": "devices.d_porch.brightness",
          "op": "eq",
          "value": 60,
          "weight": 2,
          "hint": "it comes on at 70% — one step down on the brightness slider"
        },
        {
          "name": "No other light was touched",
          "path": "derived.lightsOnCount",
          "op": "eq",
          "value": 6,
          "hint": "five were already on; the porch makes six"
        }
      ]
    },
    {
