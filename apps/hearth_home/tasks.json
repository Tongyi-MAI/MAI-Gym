    {
      "id": "T07_query_top_room",
      "name": "Question: hungriest room",
      "level": "L2",
      "seed": 0,
      "max_steps": 16,
      "answer_expected": true,
      "tags": [
        "energy",
        "query",
        "read-only"
      ],
      "instruction": "Which room used the most energy this week? Answer with the room name.",
      "goal": [
        {
          "name": "The answer is the Kitchen",
          "source": "answer",
          "op": "regex",
          "value": "[Kk]itchen",
          "weight": 3,
          "hint": "the Energy tab breaks the week down by room"
