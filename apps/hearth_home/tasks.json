      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings",
        "toggle"
      ],
      "instruction": "In Settings, switch the temperature units to Fahrenheit and turn off device alerts. Leave every other setting alone.",
