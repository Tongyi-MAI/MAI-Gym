    {
      "id": "T11_priority_no",
      "name": "Is priority boarding worth it here?",
      "level": "L2",
      "seed": 0,
      "max_steps": 22,
      "tags": [
        "trade-off"
      ],
      "instruction": "Priority boarding buys 2 kg of extra cabin allowance for £12. Work out whether it would reduce what you pay from where you are now, then leave the booking in the cheaper of the two states and tell me your reasoning in one line.",
      "goal": [
        {
          "name": "Priority is off",
          "path": "derived.settings.priority",
          "op": "eq",
          "value": false
        },
        {
          "name": "No second bag",
          "path": "derived.extraBagBooked",
          "op": "eq",
          "value": false
        },
        {
          "name": "it does not help",
          "source": "answer",
          "op": "regex",
          "value": "(?<![A-Za-z])(?:(no|not|doesn|does not|isn|is not|worse|cabin is))",
          "weight": 3,
          "hint": "which bag is actually over?"
        },
        {
          "name": "Nothing was left at home",
          "path": "derived.unpackedCount",
          "op": "eq",
          "value": 0
        },
        {
          "name": "and says which bag is the problem",
          "source": "answer",
          "op": "regex",
          "value": "(?<![A-Za-z])(?:hold)"
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T12_second_bag_no",
