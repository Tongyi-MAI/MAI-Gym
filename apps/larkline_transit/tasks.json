          "name": "Step-free routing is on",
          "path": "settings.stepFreeOnly",
          "op": "eq",
          "value": true,
          "weight": 2
        },
        {
          "name": "Crowding is off",
          "path": "settings.showCrowding",
          "op": "eq",
          "value": false,
          "weight": 2
        },
        {
          "name": "Disruption alerts untouched",
          "path": "settings.notifyDisruption",
          "op": "eq",
          "value": true
        }
      ]
