    {
      "id": "T01_settings",
      "name": "Two settings",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "In Settings, turn on step-free routes only and turn off the setting that shows how busy trains are. Leave the disruption alerts alone.",
