    {
      "id": "T15_two_units",
      "name": "Both of the first two units",
      "level": "L3",
      "seed": 0,
      "max_steps": 60,
      "tags": [
        "lesson",
        "long-horizon"
      ],
      "instruction": "Finish unit 1 and unit 2, both of them, in one sitting.",
