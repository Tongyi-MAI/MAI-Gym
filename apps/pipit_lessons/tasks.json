      "seed": 0,
      "max_steps": 30,
      "unique_solution": false,
      "tags": [
        "lesson",
        "streak",
        "multi-solution"
      ],
      "instruction": "Get four correct answers in a row in any lesson you like. Stay in the lesson once you have them.",
