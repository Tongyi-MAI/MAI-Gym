    {
      "id": "T19_fail_then_perfect",
      "name": "Fail it, then do it properly",
      "level": "L3",
      "seed": 0,
      "max_steps": 60,
      "tags": [
        "lesson",
        "retry",
        "long-horizon",
        "accuracy"
