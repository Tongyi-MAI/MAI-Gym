        {
          "name": "Unit 1 among them",
          "path": "derived.lessonsDone",
          "op": "contains",
          "value": "Bread and water",
          "weight": 2
        },
        {
          "name": "Unit 2 among them",
          "path": "derived.lessonsDone",
          "op": "contains",
          "value": "The house and the cat",
          "weight": 2
        },
        {
          "name": "At least 280 XP",
