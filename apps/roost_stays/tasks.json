          "weight": 2
        },
        {
          "name": "Total is under $600",
          "path": "bookings[last].total",
          "op": "lt",
          "value": 600,
          "weight": 2
        },
        {
          "name": "Booking is upcoming",
          "path": "bookings[last].status",
          "op": "eq",
          "value": "upcoming"
        }
      ]
    },
