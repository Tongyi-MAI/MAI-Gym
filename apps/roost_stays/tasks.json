    {
      "id": "T08_constraint_booking",
      "name": "Constrained booking (many valid answers)",
      "level": "L3",
      "seed": 0,
      "max_steps": 30,
      "unique_solution": false,
      "tags": [
        "booking",
        "constraint",
        "multi-solution"
      ],
      "instruction": "Book any stay that sleeps at least 4 people and offers free cancellation, for exactly 3 nights, with a total under $600. Keep the default guest count and add nothing extra.",
      "notes": "Pinecrest Cabin ($542) and Blue Heron Cottage ($446) both satisfy it; Saltwater Bungalow sleeps 4 but has no free cancellation. The goal checks the constraint, not a particular stay.",
      "goal": [
        {
          "name": "A third booking exists",
          "path": "bookings",
          "op": "len_eq",
          "value": 3
        },
        {
          "name": "Exactly three nights",
          "path": "bookings[last].nights",
          "op": "eq",
          "value": 3
        },
        {
          "name": "The stay sleeps at least 4",
          "path": "derived.lastBookingStay.guests",
          "op": "gte",
          "value": 4,
          "weight": 2,
          "hint": "Saltwater Bungalow sleeps 4 but fails the cancellation rule"
