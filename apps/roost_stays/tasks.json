    {
      "id": "T01_currency_and_optout",
      "name": "Switch currency, opt out of marketing",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings",
        "toggle",
        "single-screen"
      ],
      "instruction": "Open Settings, switch the display currency to EUR and turn off marketing emails. Leave every other setting exactly as it is.",
      "goal": [
        {
          "name": "Currency is EUR",
          "path": "profile.settings.currency",
          "op": "eq",
          "value": "EUR"
        },
        {
          "name": "Marketing emails are off",
          "path": "profile.settings.marketing",
          "op": "eq",
          "value": false
        },
        {
          "name": "Trip updates are still on",
          "path": "profile.settings.tripUpdates",
          "op": "eq",
          "value": true,
          "hint": "distractor — the agent must not switch this one off as well"
        },
        {
          "name": "Step-free filter untouched",
          "path": "profile.settings.accessibleOnly",
          "op": "eq",
          "value": false
        }
      ]
    },
    {
      "id": "T02_wishlist_two",
