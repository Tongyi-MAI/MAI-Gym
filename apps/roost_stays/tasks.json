    {
      "id": "T04_query_cheapest_pet_friendly",
      "name": "Question: cheapest pet-friendly stay",
      "level": "L2",
      "seed": 0,
      "max_steps": 26,
      "answer_expected": true,
      "tags": [
        "query",
        "filter",
        "compare",
        "read-only"
      ],
      "instruction": "Among the stays that allow pets AND offer free cancellation, which has the lowest nightly price? Answer with just the number of dollars. Do not book anything.",
      "notes": "Pinecrest Cabin $148 and Blue Heron Cottage $118 qualify; Cedar Treehouse allows pets but has no free cancellation.",
      "goal": [
        {
          "name": "The answer is 118",
          "source": "answer",
          "op": "eq",
          "value": 118,
          "extract": "number",
          "weight": 3,
          "hint": "the Pets allowed and Free cancellation filters on the results screen narrow it to two stays"
        },
        {
          "name": "Nothing was booked",
          "path": "bookings",
          "op": "len_eq",
          "value": 2,
          "hint": "read-only task — a booking is an automatic failure"
        },
        {
          "name": "Nothing was saved either",
          "path": "wishlist",
          "op": "len_eq",
          "value": 0
        }
      ]
    },
    {
      "id": "T05_custom_booking_flagship",
      "name": "Full custom booking (flagship)",
      "level": "L3",
      "seed": 0,
      "max_steps": 45,
      "tags": [
        "booking",
        "calendar",
        "guests",
        "add-ons",
        "promo",
        "payment",
        "long-horizon"
      ],
      "instruction": "Book Pinecrest Cabin from June 20 to June 23, 2026 for 3 adults, 1 child and 1 dog. Add the daily breakfast basket and the late checkout, but NOT the airport pickup. Apply the promo code ROOST20, pay with the Visa card rather than the default one, and leave the host the note \"Arriving late, around 10pm\". Then confirm and pay.",
      "notes": "148 x 3 = 444, +45 cleaning, +53 service, +54 breakfast, +25 late checkout, -89 promo = 532.",
      "goal": [
        {
          "name": "A third booking exists",
          "path": "bookings",
          "op": "len_eq",
          "value": 3
        },
        {
          "name": "It is Pinecrest Cabin",
          "path": "bookings[last].stayId",
          "op": "eq",
          "value": "p_cabin"
        },
        {
          "name": "Jun 20 to Jun 23, three nights",
          "path": "bookings[last].nights",
          "op": "eq",
          "value": 3
        },
        {
          "name": "Check-in date is right",
          "path": "bookings[last].checkIn",
          "op": "eq",
          "value": "2026-06-20"
        },
        {
          "name": "Check-out date is right",
          "path": "bookings[last].checkOut",
          "op": "eq",
          "value": "2026-06-23"
        },
        {
          "name": "3 adults, 1 child, 1 pet",
          "path": "bookings[last].guests",
          "op": "multiset_eq",
          "project": [
            "adults",
            "children",
            "pets"
          ],
          "weight": 2,
          "value": [
            {
              "adults": 3,
              "children": 1,
              "pets": 1
            }
          ],
          "hint": "the guest sheet has three separate steppers"
        },
        {
          "name": "Breakfast and late checkout, no pickup",
          "path": "bookings[last].addons",
          "op": "set_eq",
          "value": [
            "breakfast",
            "checkout"
          ],
          "weight": 2,
          "hint": "airport pickup is a distractor and must stay off"
        },
        {
          "name": "Promo ROOST20 applied",
          "path": "bookings[last].promo",
          "op": "eq",
          "value": "ROOST20"
        },
        {
          "name": "Discount is $89",
          "path": "bookings[last].price.discount",
          "op": "eq",
          "value": 89
        },
        {
          "name": "Paid with the Visa",
          "path": "bookings[last].paymentId",
          "op": "eq",
          "value": "pm_visa",
          "weight": 2,
          "hint": "the Amex is the default, so this needs an explicit switch"
        },
        {
          "name": "Host note mentions 10pm",
          "path": "bookings[last].note",
          "op": "contains",
          "value": "10pm"
        },
        {
          "name": "Total is $532",
          "path": "bookings[last].total",
          "op": "eq",
          "value": 532,
          "weight": 2
        },
        {
          "name": "Booking is upcoming",
          "path": "bookings[last].status",
          "op": "eq",
          "value": "upcoming"
        },
        {
          "name": "The draft was cleared",
          "path": "draft.stayId",
          "op": "eq",
          "value": null
        },
        {
          "name": "Efficiency: 30 steps or fewer",
          "source": "trajectory",
          "path": "steps",
          "op": "lte",
          "value": 30,
          "critical": false,
          "weight": 0.5,
          "hint": "not required — only used to separate good runs from lucky ones"
        }
      ]
    },
