      "level": "L2",
      "seed": 0,
      "max_steps": 16,
      "tags": [
        "list",
        "confirm-dialog"
      ],
      "instruction": "Add the chickpea tagine to your list, then think better of the whole thing and empty the list completely.",
      "goal": [
        {
          "name": "Nothing left",
          "path": "derived.listCount",
          "op": "eq",
          "value": 0,
          "weight": 3
        },
        {
          "name": "The tagine really was added first",
          "source": "trajectory",
          "path": "ids",
          "op": "contains",
          "value": "add_to_list",
          "weight": 2
        },
        {
          "name": "The dialog was confirmed",
          "source": "trajectory",
          "path": "ids",
          "op": "contains",
          "value": "confirm_ok",
          "weight": 2
        }
      ]
    },
