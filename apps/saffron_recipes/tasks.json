{
  "env": "saffron_recipes",
  "version": "1.0.0",
  "tasks": [
    {
      "id": "T01_settings",
      "name": "Two settings",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "In Settings, stop the app leaving cupboard staples off the shopping list, and make planned meals default to four servings.",
      "goal": [
        {
          "name": "Staples are included now",
          "path": "settings.skipStaples",
          "op": "eq",
          "value": false,
          "weight": 2
        },
        {
          "name": "Four servings by default",
          "path": "settings.defaultServings",
          "op": "eq",
          "value": 4,
          "weight": 2
        },
        {
          "name": "Nutrition setting untouched",
          "path": "settings.showNutrition",
          "op": "eq",
          "value": false
        }
      ]
    },
    {
      "id": "T02_query_time",
      "name": "Question: how long the ragu takes",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "answer_expected": true,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "How long does the Sunday ragu take?",
      "goal": [
        {
          "name": "Three hours",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)(?:180|3 ?h)(?!\\d)",
          "weight": 3
        },
        {
          "name": "Nothing was added to the list",
          "path": "derived.listCount",
          "op": "eq",
          "value": 2
        }
      ]
    },
    {
      "id": "T03_save",
      "name": "Save the crumble",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "tags": [
        "favourites"
      ],
      "instruction": "Save the apple crumble so it turns up under Saved.",
      "goal": [
        {
          "name": "It is saved",
          "path": "derived.saved",
          "op": "contains",
          "value": "Apple crumble",
          "weight": 3
        },
        {
          "name": "The dal is still saved",
          "path": "derived.saved",
          "op": "set_eq",
          "value": [
            "Apple crumble",
            "Red lentil dal"
          ]
        }
      ]
    },
    {
      "id": "T04_scale",
      "name": "Ragu for six",
      "level": "L2",
      "seed": 0,
      "max_steps": 16,
      "tags": [
        "scaling",
        "list"
      ],
      "instruction": "Add the Sunday ragu to your shopping list, but for six people rather than the four it is written for.",
      "goal": [
        {
          "name": "Set to six servings",
          "path": "derived.servings.Sunday ragu",
          "op": "eq",
          "value": 6,
          "weight": 2
        },
        {
          "name": "750 g of mince",
          "path": "derived.listQty.Beef mince",
          "op": "eq",
          "value": 750000,
          "weight": 3,
          "hint": "500 g written for four"
        },
        {
          "name": "1.2 kg of tomatoes",
          "path": "derived.listQty.Chopped tomatoes",
          "op": "eq",
          "value": 1200000,
          "weight": 2
        },
        {
          "name": "An onion and a half",
          "path": "derived.listQty.Onion",
          "op": "eq",
          "value": 1500,
          "weight": 2,
          "hint": "onions round to halves, not to whole ones"
        },
        {
          "name": "Ten lines on the list",
          "path": "derived.listCount",
          "op": "eq",
          "value": 10
        }
      ]
    },
    {
      "id": "T05_merge",
      "name": "Two recipes, one onion line",
      "level": "L2",
      "seed": 0,
      "max_steps": 18,
      "tags": [
        "list",
        "aggregation"
      ],
      "instruction": "Add both the Sunday ragu and the red lentil dal to your shopping list, each as written. They both want onions and garlic — those should end up on one line each.",
      "goal": [
        {
          "name": "Two onions on one line",
          "path": "derived.listQty.Onion",
          "op": "eq",
          "value": 2000,
          "weight": 3,
          "hint": "one from each recipe"
        },
        {
          "name": "Six cloves of garlic",
          "path": "derived.listQty.Garlic",
          "op": "eq",
          "value": 6000,
          "weight": 2
        },
        {
          "name": "The line knows where it came from",
          "path": "derived.listFrom.Onion",
          "op": "set_eq",
          "value": [
            "Red lentil dal",
            "Sunday ragu"
          ],
          "weight": 2
        },
        {
          "name": "Seventeen lines, not nineteen",
          "path": "derived.listCount",
          "op": "eq",
          "value": 17,
          "weight": 2
        }
      ]
    },
    {
      "id": "T06_query_scale",
      "name": "Question: pasta for four",
      "level": "L2",
      "seed": 0,
      "max_steps": 14,
      "answer_expected": true,
      "tags": [
        "scaling",
        "query"
      ],
      "instruction": "The summer pesto pasta is written for two. How much pasta do you need to make it for four? Answer in grams.",
      "goal": [
        {
          "name": "400 g",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)(?:400)(?!\\d)",
          "weight": 3
        },
        {
          "name": "The recipe really is set to four",
          "path": "derived.servings.Summer pesto pasta",
          "op": "eq",
          "value": 4,
          "weight": 2
        },
        {
          "name": "Nothing was added to the list",
          "path": "derived.listCount",
          "op": "eq",
          "value": 2
        }
      ]
    },
    {
      "id": "T07_staples",
      "name": "Include the salt and the oil",
      "level": "L2",
      "seed": 0,
      "max_steps": 18,
      "tags": [
        "settings",
        "list",
        "staples"
      ],
      "instruction": "You have run out of everything, cupboard included. Change the setting so staples are not left off, then add the potato tortilla to your list.",
      "goal": [
        {
          "name": "Staples are included",
          "path": "settings.skipStaples",
          "op": "eq",
          "value": false,
          "weight": 2
        },
        {
          "name": "Olive oil made it onto the list",
          "path": "derived.listQty.Olive oil",
          "op": "eq",
          "value": 6000,
          "weight": 3,
          "hint": "it would have been skipped before"
        },
        {
          "name": "So did the salt",
          "path": "derived.listQty.Salt",
          "op": "eq",
          "value": 2000,
          "weight": 2
        },
        {
          "name": "Seven lines",
          "path": "derived.listCount",
          "op": "eq",
          "value": 7,
          "weight": 2
        }
      ]
    },
    {
      "id": "T08_one_ingredient",
      "name": "Just the pine nuts",
      "level": "L2",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "list",
        "precision"
      ],
      "instruction": "You have everything for the pesto except the pine nuts. Put only those on the shopping list, at the quantity the recipe is written for.",
      "goal": [
        {
          "name": "30 g of pine nuts",
          "path": "derived.listQty.Pine nuts",
          "op": "eq",
          "value": 30000,
          "weight": 3
        },
        {
          "name": "Nothing else was added",
          "path": "derived.listCount",
          "op": "eq",
          "value": 3,
          "weight": 3,
          "hint": "the whole recipe would have added eight lines"
        }
      ]
    },
    {
      "id": "T09_tick_clear",
      "name": "Tick it off, then clear it",
      "level": "L2",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "list",
        "checkbox"
      ],
      "instruction": "Tick the pasta off your shopping list, then clear everything that is ticked.",
      "goal": [
