        {
          "name": "the tiling",
          "source": "answer",
          "op": "regex",
          "value": "[Tt]iling",
          "weight": 3
        },
        {
          "name": "the painting",
          "source": "answer",
          "op": "regex",
          "value": "[Pp]aint",
          "weight": 3
        },
        {
          "name": "Nothing was changed",
          "path": "derived.projectDays",
          "op": "eq",
          "value": 23
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T06_cannot_buy",
      "name": "The one job you cannot buy",
      "level": "L1",
      "seed": 0,
      "max_steps": 14,
      "tags": [
        "query",
        "refusal"
      ],
      "instruction": "Screed drying is five days and it is holding other work up. Open it and tell me what the app offers you to shorten it.",
      "goal": [
        {
          "name": "nothing to buy",
          "source": "answer",
          "op": "regex",
          "value": "(?<![A-Za-z])(?:(nothing|no|cannot|can't|can not))",
          "weight": 3
        },
        {
          "name": "You are on the drying job",
          "path": "derived.routeId",
          "op": "eq",
          "value": "t_dry"
        },
        {
          "name": "It is still five days",
          "path": "derived.jobDays.Screed drying",
          "op": "eq",
          "value": 5
        },
        {
          "name": "Nothing was bought",
          "path": "derived.crashSpend",
          "op": "eq",
          "value": 0
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T07_float_trap",
      "name": "The cheapest day on the board",
      "level": "L2",
      "seed": 0,
      "max_steps": 18,
      "tags": [
        "trap",
        "multi-step"
      ],
      "instruction": "Painting is the cheapest job to speed up at £110 a day. Buy exactly one day off it, then tell me what it did to the finish date.",
      "goal": [
        {
          "name": "Painting is down to three days",
          "path": "derived.jobDays.Painting",
          "op": "eq",
          "value": 3
        },
        {
          "name": "£110 was spent",
          "path": "derived.crashSpend",
          "op": "eq",
          "value": 11000
        },
        {
          "name": "The build is still 23 days",
          "path": "derived.projectDays",
          "op": "eq",
          "value": 23
        },
        {
          "name": "nothing — it has float",
          "source": "answer",
          "op": "regex",
          "value": "(nothing|no change|did not|didn't|same|float)",
          "weight": 3,
          "hint": "look at the float on the bar before you decide it was money well spent"
        }
      ],
      "answer_expected": true
    },
    {
