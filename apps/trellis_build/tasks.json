          "name": "no, not on its own",
          "source": "answer",
          "op": "regex",
          "value": "(?<![A-Za-z])(?:(no|not|didn|did not|nothing|same|still (?<!\\d)23(?!\\d)))",
          "weight": 3,
          "hint": "painting was not what the finish date was waiting on"
        }
