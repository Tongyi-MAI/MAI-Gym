{
  "env": "trellis_build",
  "version": "1.0.0",
  "tasks": [
    {
      "id": "T01_settings",
      "name": "Two switches",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "On the Site tab, put the crew on seven-day weeks and stop the app drawing float on the bars. Leave the third switch alone.",
      "goal": [
        {
          "name": "Weekends are worked",
          "path": "derived.settings.workWeekends",
          "op": "eq",
          "value": true
        },
        {
          "name": "Float is no longer drawn",
          "path": "derived.settings.showFloat",
          "op": "eq",
          "value": false
        },
        {
          "name": "The third switch is untouched",
          "path": "derived.settings.warnSlip",
          "op": "eq",
          "value": true
        },
        {
          "name": "Nothing was bought",
          "path": "derived.crashSpend",
          "op": "eq",
          "value": 0
        }
      ]
    },
    {
      "id": "T02_finish",
      "name": "Question: when does it finish?",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "How many working days is the build, and what date does it finish on as the plan stands?",
      "goal": [
        {
          "name": "23 working days",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)23(?!\\d)",
          "weight": 3
        },
        {
          "name": "Wednesday 6 May",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)6(?!\\d) May",
          "weight": 3
        },
        {
          "name": "Nothing was changed",
          "path": "derived.projectDays",
          "op": "eq",
          "value": 23
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T03_critical",
      "name": "Question: how much of it is critical?",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "How many of the twelve jobs have no float at all?",
      "goal": [
        {
          "name": "six",
          "source": "answer",
          "op": "regex",
          "value": "((?<!\\d)6(?!\\d)|[Ss]ix)",
          "weight": 3
        },
        {
          "name": "Nothing was changed",
          "path": "derived.criticalCount",
          "op": "eq",
          "value": 6
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T04_tiling_float",
      "name": "Open the tiling and read its float",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "query",
        "navigate"
      ],
      "instruction": "Open the tiling job and tell me how many days of float it has.",
      "goal": [
        {
          "name": "four days",
          "source": "answer",
          "op": "regex",
          "value": "((?<!\\d)4(?!\\d)|[Ff]our)",
          "weight": 3
        },
        {
          "name": "You are on the tiling job",
          "path": "derived.routeId",
          "op": "eq",
          "value": "t_tile"
        },
        {
          "name": "Nothing was bought",
          "path": "derived.crashSpend",
          "op": "eq",
          "value": 0
        }
      ],
      "answer_expected": true
    },
    {
