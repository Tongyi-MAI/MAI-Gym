  "tasks": [
    {
      "id": "T01_settings",
      "name": "Two switches",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "In Setup, switch off the month-by-month table and stop the app spelling the transfer fee out. Leave the third switch alone.",
      "goal": [
        {
          "name": "The table is off",
          "path": "derived.settings.showSchedule",
          "op": "eq",
          "value": false
        },
        {
          "name": "The fee is no longer spelled out",
          "path": "derived.settings.showFee",
          "op": "eq",
          "value": false
        },
        {
          "name": "The third switch is untouched",
          "path": "derived.settings.notifyCleared",
          "op": "eq",
          "value": true
        },
        {
          "name": "The plan was not changed",
          "path": "derived.budget",
          "op": "eq",
          "value": 52000
        }
      ]
    },
    {
      "id": "T02_now",
