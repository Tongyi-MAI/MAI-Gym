          "name": "The budget is £400",
          "path": "derived.budget",
          "op": "eq",
          "value": 40000
        },
        {
          "name": "It is not workable",
          "path": "derived.feasible",
          "op": "eq",
          "value": false
        },
        {
          "name": "the loan payment plus the card minimum",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)(?:(348|minimum|cover|408))(?!\\d)",
          "weight": 3
        }
      ],
      "answer_expected": true
    },
