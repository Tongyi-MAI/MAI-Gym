    {
      "id": "T05_rules",
      "name": "Question: how the card works",
      "level": "L1",
      "seed": 0,
      "max_steps": 14,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "What monthly interest rate does the credit card charge, and how is its minimum payment worked out?",
      "goal": [
        {
          "name": "1.825% a month",
          "source": "answer",
          "op": "regex",
          "value": "(?<![\\d.,+-])(?:1[.,]825)(?!\\d|[.,]\\d)",
          "weight": 3
        },
        {
          "name": "2.5% or £25",
          "source": "answer",
          "op": "regex",
          "value": "(?<![\\d.,+-])(?:2[.,]5)(?!\\d|[.,]\\d)",
          "weight": 3
        },
        {
          "name": "Nothing was changed",
          "path": "derived.budget",
          "op": "eq",
          "value": 52000
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T06_too_little",
      "name": "Four hundred is not enough",
      "level": "L1",
      "seed": 0,
      "max_steps": 14,
      "tags": [
        "refusal"
      ],
      "instruction": "Pull the monthly budget down to £400 and tell me why the app cannot plan anything with it.",
      "goal": [
