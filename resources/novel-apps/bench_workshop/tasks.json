    {
      "id": "T15_where_screws",
      "name": "Where the screws go",
      "level": "L3",
      "seed": 0,
      "max_steps": 22,
      "tags": [
        "reasoning",
        "query"
      ],
      "instruction": "The two products between them ask for 96 screws on this plan, but the app wants 216. Where do the other 120 go? Do not change anything.",
      "goal": [
        {
          "name": "The plan is untouched",
          "path": "derived.benches",
          "op": "eq",
          "value": 6
        },
        {
          "name": "Nothing was ordered",
          "path": "derived.basketCost",
          "op": "eq",
          "value": 0
        },
        {
          "name": "120",
          "source": "answer",
          "op": "regex",
          "value": "(?<![\\d.,+-])120(?:[.,]0+)?(?!\\d|[.,]\\d)",
          "weight": 3
        },
        {
          "name": "into the legs that have to be built",
          "source": "answer",
          "op": "regex",
          "value": "(leg|assembl|built)",
          "weight": 3,
          "hint": "thirty legs have to be built and each one takes four"
        },
        {
          "name": "Required: plan",
          "source": "state",
          "path": "plan",
          "op": "eq",
          "value": {
            "p_bench": 6,
            "p_table": 3
          }
        }
      ],
      "answer_expected": true
    },
