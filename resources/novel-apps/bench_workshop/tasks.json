{
  "env": "bench_workshop",
  "version": "1.0.0",
  "tasks": [
    {
      "id": "T01_settings",
      "name": "Two switches",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "In Setup, stop the shelf printing pack sizes and switch the app over to gross requirements instead of netting the plan off what is in stock. Leave the third switch alone.",
      "goal": [
        {
          "name": "Pack sizes are hidden",
          "path": "derived.settings.showPacks",
          "op": "eq",
          "value": false
        },
        {
          "name": "Gross requirements",
          "path": "derived.settings.netOffStock",
          "op": "eq",
          "value": false
        },
        {
          "name": "The third switch is untouched",
          "path": "derived.settings.warnShort",
          "op": "eq",
          "value": true
        },
        {
          "name": "The plan was not changed",
          "path": "derived.benches",
          "op": "eq",
          "value": 6
        }
      ]
    },
    {
      "id": "T02_fix_cost",
      "name": "Question: what does the shortfall cost?",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "The plan as it stands does not fit on the shelf. How much would it cost to order what is missing? Answer with only the requested number.",
      "goal": [
        {
          "name": "Nothing was ordered",
          "path": "derived.basketCost",
          "op": "eq",
          "value": 0
        },
        {
          "name": "Requested numeric answer",
          "source": "answer",
          "op": "eq",
          "value": 39,
          "extract": "single_number"
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T03_what_short",
      "name": "Question: what is short?",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "Which parts is the plan short of, and by how many of each?",
      "goal": [
        {
          "name": "dowels",
          "source": "answer",
          "op": "regex",
          "value": "[Dd]owel",
          "weight": 3
        },
        {
          "name": "ten of them",
          "source": "answer",
          "op": "regex",
          "value": "((?<!\\d)10(?!\\d)|[Tt]en)",
          "weight": 3
        },
        {
          "name": "screws",
          "source": "answer",
          "op": "regex",
          "value": "[Ss]crew",
          "weight": 3
        },
        {
          "name": "sixteen of them",
          "source": "answer",
          "op": "regex",
          "value": "((?<!\\d)16(?!\\d)|[Ss]ixteen)",
          "weight": 3
        },
        {
          "name": "Nothing was ordered",
          "path": "derived.basketCost",
          "op": "eq",
          "value": 0
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T04_screws",
      "name": "Open the screws",
      "level": "L1",
      "seed": 0,
      "max_steps": 14,
      "tags": [
        "query",
        "navigate"
      ],
      "instruction": "Open the M8 screw and tell me how many this plan needs in total. Answer with only the requested number.",
      "goal": [
        {
          "name": "You are on the screw page",
          "path": "derived.routeId",
          "op": "eq",
          "value": "r_screw"
        },
        {
          "name": "The plan was not changed",
          "path": "derived.benches",
          "op": "eq",
          "value": 6
        },
        {
          "name": "Requested numeric answer",
          "source": "answer",
          "op": "eq",
          "value": 216,
          "extract": "single_number"
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T05_legs",
      "name": "Question: the legs",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "How many leg assemblies does the current plan need in total, and how many must be built after using the stock on the rack? Reply with only the numbers in that order, separated by semicolons.",
      "goal": [
        {
          "name": "The plan was not changed",
          "path": "derived.legsWanted",
          "op": "eq",
          "value": 36
        },
        {
          "name": "All requested quantities",
          "source": "answer",
          "op": "eq",
          "value": [
            36,
            30
          ],
          "extract": "numbers"
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T06_no_room",
      "name": "No room for another",
      "level": "L1",
      "seed": 0,
      "max_steps": 14,
      "tags": [
        "refusal"
      ],
      "instruction": "Press the max button on the garden bench and tell me what the app says.",
      "goal": [
        {
          "name": "The plan did not move",
          "path": "derived.benches",
          "op": "eq",
          "value": 6
        },
        {
          "name": "Tables did not move either",
          "path": "derived.tables",
          "op": "eq",
          "value": 3
        },
        {
          "name": "no room for another",
          "source": "answer",
          "op": "regex",
          "value": "(no room|none|(?<!\\d)0(?!\\d)|cannot|can't|short)",
          "weight": 3
        },
        {
          "name": "and says what runs out",
          "source": "answer",
          "op": "regex",
          "value": "(?<![A-Za-z])(?:shelf|carri|carry|past|already|room)"
        },
        {
          "name": "Required: accepted_events[?action.action=tap][?action.id=max_p_bench]",
          "source": "trajectory",
          "path": "accepted_events[?action.action=tap][?action.id=max_p_bench]",
          "op": "len_gte",
          "value": 1
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T07_max_bench",
      "name": "As many benches as the shelf carries",
      "level": "L2",
      "seed": 0,
      "max_steps": 20,
      "tags": [
        "optimise"
      ],
      "instruction": "Empty the plan, then make as many garden benches as you can without ordering anything. How many is that? Answer with only the requested number.",
      "goal": [
        {
          "name": "Seven benches",
          "path": "derived.benches",
          "op": "eq",
          "value": 7
        },
        {
          "name": "No tables",
          "path": "derived.tables",
          "op": "eq",
          "value": 0
        },
        {
          "name": "It fits on the shelf",
          "path": "derived.feasible",
          "op": "eq",
          "value": true
        },
        {
          "name": "Nothing was ordered",
          "path": "derived.basketCost",
          "op": "eq",
          "value": 0
        },
        {
          "name": "Requested numeric answer",
          "source": "answer",
          "op": "eq",
          "value": 7,
          "extract": "single_number"
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T08_max_table",
      "name": "As many side tables as the shelf carries",
      "level": "L2",
      "seed": 0,
      "max_steps": 20,
      "tags": [
        "optimise"
      ],
      "instruction": "Empty the plan and plan to make only side tables — as many as the shelf carries, nothing ordered. How many, and what stops you at that number?",
      "goal": [
        {
          "name": "Three tables",
          "path": "derived.tables",
          "op": "eq",
          "value": 3
        },
        {
          "name": "No benches",
          "path": "derived.benches",
          "op": "eq",
          "value": 0
        },
        {
          "name": "It fits on the shelf",
          "path": "derived.feasible",
          "op": "eq",
          "value": true
        },
        {
          "name": "three",
          "source": "answer",
          "op": "regex",
          "value": "((?<!\\d)3(?!\\d)|[Tt]hree)",
          "weight": 3
        },
        {
          "name": "the table tops",
          "source": "answer",
          "op": "regex",
          "value": "[Tt]op",
          "weight": 3
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T09_trade",
      "name": "Three tables, then benches",
      "level": "L2",
      "seed": 0,
      "max_steps": 24,
      "tags": [
        "optimise",
        "trade-off"
      ],
      "instruction": "Empty the plan, put three side tables in it, and then add as many benches as the shelf will still carry. How many benches? Answer with only the requested number.",
      "goal": [
        {
          "name": "Three tables",
          "path": "derived.tables",
          "op": "eq",
          "value": 3
        },
        {
          "name": "Four benches",
          "path": "derived.benches",
          "op": "eq",
          "value": 4
        },
        {
          "name": "It fits on the shelf",
          "path": "derived.feasible",
          "op": "eq",
          "value": true
        },
        {
          "name": "Nothing was ordered",
          "path": "derived.basketCost",
          "op": "eq",
          "value": 0
        },
        {
          "name": "Requested numeric answer",
          "source": "answer",
          "op": "eq",
          "value": 4,
          "extract": "single_number"
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T10_order",
      "name": "Order the shortfall",
      "level": "L2",
      "seed": 0,
      "max_steps": 16,
      "tags": [
        "multi-step",
        "commit"
      ],
      "instruction": "Order exactly what the current plan is missing, and tell me what it came to. Answer with only the requested number.",
      "goal": [
