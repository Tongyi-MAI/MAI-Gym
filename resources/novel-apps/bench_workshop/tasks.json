          "value": 6
        },
        {
          "name": "Requested numeric answer",
          "source": "answer",
          "op": "eq",
          "value": 39,
          "extract": "single_number"
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T11_pack_cliff",
      "name": "Two dowels, fifteen pounds",
      "level": "L2",
      "seed": 0,
      "max_steps": 26,
      "tags": [
        "cliff",
        "multi-step"
      ],
      "instruction": "Empty the plan and set it to seven benches and one side table. You will be short by a handful of one part. Say how many you are short and what putting it right costs.",
      "goal": [
        {
          "name": "Seven benches",
          "path": "derived.benches",
          "op": "eq",
          "value": 7
        },
        {
          "name": "One table",
          "path": "derived.tables",
          "op": "eq",
          "value": 1
        },
        {
          "name": "It costs £15 to fix",
          "path": "derived.fixCost",
          "op": "eq",
          "value": 1500
        },
        {
          "name": "Nothing was ordered yet",
          "path": "derived.basketCost",
          "op": "eq",
          "value": 0
        },
        {
          "name": "two dowels short",
          "source": "answer",
          "op": "regex",
          "value": "((?<!\\d)2(?!\\d)|[Tt]wo)",
          "weight": 3
        },
        {
          "name": "£15",
          "source": "answer",
          "op": "regex",
          "value": "(?<![\\d.,+-])15(?:[.,]0+)?(?!\\d|[.,]\\d)",
          "weight": 3,
          "hint": "dowels come twenty-five to a pack"
        }
      ],
      "answer_expected": true
    },
    {
