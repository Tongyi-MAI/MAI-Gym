    {
      "id": "T03_strong",
      "name": "问一句：几组证据充分",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "四组建议里，有几组是「证据充分」的？剩下的那组凭的是什么？",
      "goal": [
        {
          "name": "3 组",
          "source": "answer",
          "op": "regex",
          "value": "(?<![\\d.,+-])3(?:[.,]0+)?(?!\\d|[.,]\\d)",
          "weight": 3
