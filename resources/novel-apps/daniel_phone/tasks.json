{
  "env": "daniel_phone",
  "version": "1.0.0",
  "tasks": [
    {
      "id": "T01_free",
      "name": "How tight is it",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "tags": [
        "storage",
        "query",
        "read-only"
      ],
      "instruction": "How much free space is on this iPhone, and how far short of the iOS 26.1 update is that?",
      "goal": [
        {
          "name": "3.14 GB free",
          "source": "answer",
          "op": "regex",
          "value": "(?<![\\d.,+-])(?:3[.,]14)(?!\\d|[.,]\\d)"
        },
        {
          "name": "3.66 GB short",
          "source": "answer",
          "op": "regex",
          "value": "(?<![\\d.,+-])(?:3[.,]66)(?!\\d|[.,]\\d)"
        },
        {
          "name": "nothing changed",
          "path": "derived.freeDevice",
          "op": "eq",
          "value": 3140
        }
      ],
      "answer_expected": true
    },
    {
      "id": "T02_largest",
      "name": "Open the biggest app",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "tags": [
        "storage"
      ],
      "instruction": "Which app is taking up the most space on this iPhone? Open its storage page.",
      "goal": [
        {
          "name": "Sonora is open",
          "path": "derived.appOpen",
          "op": "eq",
          "value": "sonora_music"
        },
        {
          "name": "on an app page",
          "path": "derived.route",
          "op": "eq",
          "value": "app"
        }
      ]
    },
    {
      "id": "T03_empty",
      "name": "Empty Recently Deleted",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "storage",
        "photos"
      ],
      "instruction": "Empty Recently Deleted. Do not offload or delete any app.",
      "goal": [
        {
          "name": "Recently Deleted is empty",
          "path": "derived.trash",
          "op": "eq",
          "value": 0
        },
        {
          "name": "nothing offloaded",
          "path": "derived.offloadedCount",
          "op": "eq",
          "value": 0
        },
        {
          "name": "nothing deleted",
          "path": "derived.deletedCount",
          "op": "eq",
          "value": 0
        }
      ]
    },
    {
      "id": "T04_owner",
      "name": "Whose phone is this",
      "level": "L1",
      "seed": 0,
      "max_steps": 10,
      "tags": [
        "owner",
        "query",
        "read-only"
      ],
      "instruction": "Whose iPhone is this, and who is in his Family Sharing group?",
      "goal": [
        {
          "name": "Daniel Okafor",
          "source": "answer",
          "op": "regex",
          "value": "(?i)(?<!\\w)Daniel\\s+Okafor(?!\\w)"
        },
        {
          "name": "Ama",
          "source": "answer",
          "op": "regex",
          "value": "[Aa]ma"
        },
        {
          "name": "Zoe",
          "source": "answer",
          "op": "regex",
          "value": "[Zz]oe"
        },
        {
          "name": "Kwame",
          "source": "answer",
          "op": "regex",
          "value": "[Kk]wame"
        },
        {
          "name": "Grace is also in Family Sharing",
          "source": "answer",
          "op": "regex",
          "value": "(?i)\\bGrace\\b"
        }
      ],
      "answer_expected": true
    },
