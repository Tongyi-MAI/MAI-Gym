    {
      "id": "T01_settings",
      "name": "Goal and sound",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "Set the daily goal to 30 XP and turn the sound effects off.",
