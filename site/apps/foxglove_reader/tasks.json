          "source": "answer",
          "op": "eq",
          "value": 4,
          "extract": "number",
          "weight": 3
        },
        {
          "name": "The setting was not changed",
          "path": "derived.charsPerPage",
          "op": "eq",
          "value": 800
        }
      ]
    },
    {
