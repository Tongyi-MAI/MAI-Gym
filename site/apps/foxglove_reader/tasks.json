        {
          "name": "Eight pages",
          "source": "answer",
          "op": "eq",
          "value": 8,
          "extract": "number",
          "weight": 3,
          "hint": "the same words, 420 characters to a page instead of 800"
        },
        {
          "name": "And the app agrees",
          "path": "derived.pageCount",
          "op": "eq",
          "value": 8,
          "weight": 2
        }
      ]
    },
    {
