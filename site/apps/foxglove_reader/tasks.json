      "name": "Question: how long is it",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "answer_expected": true,
      "tags": [
        "query",
        "read-only"
      ],
      "instruction": "How many pages is \"The Keeper at Fell Point\" at the type size it is set to now? Answer with just the number.",
      "goal": [
