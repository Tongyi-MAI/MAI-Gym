          "op": "eq",
          "value": 3,
          "weight": 3
        },
        {
          "name": "In the reader",
          "path": "derived.route",
          "op": "eq",
          "value": "reader"
        }
      ]
    },
    {
      "id": "T04_bigger",
      "name": "Bigger type, longer book",
      "level": "L2",
      "seed": 0,
      "max_steps": 16,
      "answer_expected": true,
      "tags": [
        "pagination",
        "settings",
        "query"
      ],
      "instruction": "Put the type size up to Huge, then tell me how many pages the book has become. Answer with just the number.",
      "goal": [
        {
          "name": "Huge type",
          "path": "derived.settings.font",
          "op": "eq",
          "value": "xl",
          "weight": 2
