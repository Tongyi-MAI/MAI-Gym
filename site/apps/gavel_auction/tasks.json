    {
      "id": "T08_reserve_trap",
      "name": "Leading and still not selling",
      "level": "L2",
      "seed": 0,
      "max_steps": 20,
      "tags": [
        "reserve",
        "bidding"
      ],
      "instruction": "Become the highest bidder on the mantel clock — and then tell me whether that means you have bought it.",
      "answer_expected": true,
      "goal": [
        {
          "name": "You are leading it",
          "path": "derived.leader.Mantel clock",
          "op": "eq",
          "value": "you",
          "weight": 3
        },
        {
          "name": "At £270",
          "path": "derived.prices.Mantel clock",
          "op": "eq",
          "value": 27000,
          "weight": 2
        },
        {
          "name": "The reserve is still not met",
          "path": "derived.reserveMet.Mantel clock",
          "op": "eq",
          "value": false,
          "weight": 3
        },
        {
          "name": "And you say so",
          "source": "answer",
          "op": "regex",
          "value": "(?<![A-Za-z])(?:no|not|reserve)",
          "weight": 2
        }
      ]
    },
