{
  "env": "gavel_auction",
  "version": "1.0.0",
  "tasks": [
    {
      "id": "T01_settings",
      "name": "Two settings",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "settings"
      ],
      "instruction": "Stop the app asking you to confirm every bid, and make it watch anything you bid on.",
      "goal": [
        {
          "name": "No confirmation",
          "path": "derived.settings.confirmBids",
          "op": "eq",
          "value": false,
          "weight": 2
        },
        {
          "name": "Auto-watch on",
          "path": "derived.settings.autoWatch",
          "op": "eq",
          "value": true,
          "weight": 2
        },
        {
          "name": "Outbid alerts untouched",
          "path": "derived.settings.outbidAlerts",
          "op": "eq",
          "value": true
        }
      ]
    },
    {
      "id": "T02_query_min",
      "name": "Question: the smallest next bid",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "answer_expected": true,
      "tags": [
        "ladder",
        "query",
        "read-only"
      ],
      "instruction": "What is the smallest bid the elm and beech chair will accept? Answer in pounds and pence.",
      "goal": [
        {
          "name": "£84.00",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)84(?!\\d)",
          "weight": 3,
          "hint": "£82 now, and the step at that price is £2"
        },
        {
          "name": "You did not bid",
          "path": "derived.biddingOn",
          "op": "len_eq",
          "value": 0
        }
      ]
    },
    {
      "id": "T03_watch",
      "name": "Watch the clock",
      "level": "L1",
      "seed": 0,
      "max_steps": 12,
      "tags": [
        "watchlist"
      ],
      "instruction": "Add the mantel clock to your watchlist.",
      "goal": [
        {
          "name": "It is watched",
          "path": "derived.watching",
          "op": "contains",
          "value": "Mantel clock",
          "weight": 3
        },
        {
          "name": "Three lots watched now",
          "path": "derived.watchCount",
          "op": "eq",
          "value": 3,
          "weight": 2
        }
      ]
    },
    {
      "id": "T04_outbid",
      "name": "Bid the minimum and get beaten",
      "level": "L2",
      "seed": 0,
      "max_steps": 16,
      "tags": [
        "bidding",
        "proxy"
      ],
      "instruction": "Put the smallest allowed bid on the box of green Penguins and see what happens.",
      "goal": [
        {
          "name": "You are not leading",
          "path": "derived.leader.Box of green Penguins",
          "op": "eq",
          "value": "rival",
          "weight": 3,
          "hint": "somebody already had a higher maximum in"
        },
        {
          "name": "Your maximum is £13",
          "path": "derived.yourMax.Box of green Penguins",
          "op": "eq",
          "value": 1300,
          "weight": 2
        },
        {
          "name": "But the price moved to £14",
          "path": "derived.prices.Box of green Penguins",
          "op": "eq",
          "value": 1400,
          "weight": 3,
          "hint": "your maximum plus one step, capped at theirs"
        }
      ]
    },
    {
      "id": "T05_lead_prints",
      "name": "Take the lead on the prints",
      "level": "L2",
      "seed": 0,
      "max_steps": 18,
      "tags": [
        "bidding",
        "proxy"
      ],
      "instruction": "Become the highest bidder on the three botanical prints.",
      "goal": [
        {
          "name": "You are leading",
          "path": "derived.leader.Three botanical prints",
          "op": "eq",
          "value": "you",
          "weight": 3
        },
        {
          "name": "At £54",
          "path": "derived.prices.Three botanical prints",
          "op": "eq",
          "value": 5400,
          "weight": 3,
          "hint": "the other maximum was £52 and the step there is £2"
        },
        {
          "name": "And the reserve is met",
          "path": "derived.reserveMet.Three botanical prints",
          "op": "eq",
          "value": true,
          "weight": 2
        }
      ]
    },
    {
      "id": "T06_query_pay",
      "name": "Question: what a big maximum actually costs",
      "level": "L2",
      "seed": 0,
      "max_steps": 20,
      "answer_expected": true,
      "tags": [
        "proxy",
        "query"
      ],
      "instruction": "Put a maximum of £92 on the botanical prints. What does the lot actually stand at afterwards? Answer in pounds and pence.",
      "goal": [
        {
          "name": "£54.00",
          "source": "answer",
          "op": "regex",
          "value": "(?<!\\d)54(?!\\d)",
          "weight": 3,
          "hint": "your maximum is not the price — it is the other bidder's maximum plus a step"
        },
        {
          "name": "Your maximum really is £92",
          "path": "derived.yourMax.Three botanical prints",
          "op": "eq",
          "value": 9200,
          "weight": 2
        },
        {
          "name": "And the price really is £54",
          "path": "derived.prices.Three botanical prints",
          "op": "eq",
          "value": 5400,
          "weight": 2
        }
      ]
    },
