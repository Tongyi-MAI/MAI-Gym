    "T16_why_unique": [
      {
        "action": "tap",
        "id": "ap_0"
      },
      {
        "action": "tap",
        "id": "iso_5"
      },
      {
        "action": "finish",
        "answer": "The room wants 11 stops. The shutter cannot be slower than 1/30, which is 6; the ISO cannot be higher than 1600, which is 5; 6 + 5 = 11, so both have to be sitting exactly on their limits, and that forces the aperture to 0 — f/1.4. Move any one of them and either the exposure or a line breaks."
      }
    ],
