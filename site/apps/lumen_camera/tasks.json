    {
      "id": "T20_park_fix",
      "name": "Six stops to give away",
      "level": "L3",
      "seed": 0,
      "max_steps": 30,
      "tags": [
        "exposure",
        "constraint"
      ],
      "instruction": "Switch to the park. The frame is six stops over. Bring it back to correct without going past ISO 1600 and without a shutter slower than 1/30, and say which dials you used.",
      "goal": [
        {
          "name": "Park scene",
          "path": "derived.scene",
          "op": "eq",
          "value": "sc_park"
        },
        {
          "name": "Exposed correctly",
          "path": "derived.offBy",
          "op": "eq",
          "value": 0
        },
        {
          "name": "No smear",
          "path": "derived.blurred",
          "op": "eq",
          "value": false
        },
        {
          "name": "No grain",
