    {
      "id": "T20_queue_no_mira",
      "name": "Build a queue (many valid answers)",
      "level": "L3",
      "seed": 0,
      "max_steps": 30,
      "unique_solution": false,
      "tags": [
        "queue",
        "constraint",
        "multi-solution"
      ],
      "instruction": "Get the queue to five songs or more, with nothing from the album Paper Lantern in it, and with at least two different albums represented.",
      "notes": "Playing an album replaces the queue with the rest of that album, which gets you the length in two taps — but it leaves you with only one album in there.",
      "goal": [
        {
          "name": "At least five queued",
          "path": "derived.queueLength",
          "op": "gte",
          "value": 5,
          "weight": 3
        },
        {
          "name": "Nothing from Paper Lantern",
          "path": "derived.queueAlbums",
          "op": "not_contains",
          "value": "Paper Lantern",
          "weight": 3,
          "hint": "the three tracks queued at reset are all from Paper Lantern"
        },
        {
          "name": "At least two albums in the queue",
          "path": "derived.queueDistinctAlbums",
          "op": "gte",
          "value": 2,
          "weight": 3,
          "hint": "queue something from somewhere else as well"
        }
      ]
    }
  ]
