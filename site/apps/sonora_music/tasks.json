        {
          "name": "Sleep timer is 30 minutes",
          "path": "settings.sleep",
          "op": "eq",
          "value": "30",
          "weight": 2
        },
        {
          "name": "Quality untouched",
          "path": "settings.quality",
          "op": "eq",
          "value": "high"
        }
      ]
    },
    {
      "id": "T19_curate_likes",
      "name": "Curate Liked Songs",
      "level": "L3",
      "seed": 0,
      "max_steps": 32,
      "tags": [
        "like",
        "unlike",
        "multi-screen"
      ],
      "instruction": "Liked Songs should end up containing exactly three tracks: \"Ferry Lights\", \"Chrome Rain\" and \"Gravel Hymn\". Add and remove whatever it takes.",
      "notes": "Starts as Paper Lantern, Blue Hour Waltz and Gravel Hymn — two out, two in, one stays.",
      "goal": [
        {
          "name": "Liked Songs is exactly those three",
          "path": "derived.likedTitles",
          "op": "set_eq",
          "value": [
            "Chrome Rain",
            "Ferry Lights",
            "Gravel Hymn"
          ],
          "weight": 3
        },
        {
          "name": "Exactly three are liked",
