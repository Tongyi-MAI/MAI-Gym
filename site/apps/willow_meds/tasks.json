        {
          "name": "Levothyroxine",
          "source": "answer",
          "op": "regex",
          "value": "[Ll]evothyroxine",
          "weight": 2
        },
        {
          "name": "And vitamin D",
          "source": "answer",
          "op": "regex",
          "value": "[Vv]itamin ?D",
          "weight": 2
        },
        {
          "name": "Four hours",
          "source": "answer",
          "op": "regex",
          "value": "four|4 ?h",
          "weight": 3
        }
      ]
